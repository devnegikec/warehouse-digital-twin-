# Local development database — matches docker-compose.yml.
# Port 5433 is deliberate: it will not collide with a Homebrew Postgres on 5432.
DATABASE_URL=postgresql+psycopg://warehouse:warehouse@localhost:5433/warehouse

# Where the generated cross-language contract lives, relative to server/.
LAYOUT_SCHEMA_PATH=../packages/layout-core/schema/layout-doc.v1.json
LAYOUT_FIXTURES_PATH=../fixtures/layout-conformance
