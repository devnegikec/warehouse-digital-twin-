        "weightKg": 9000,
        "rotatable": true
      },
      "qty": 1,
      "expected": {
        "fits": true,
        "code": null,
        "orientation": [
          1.2,
          1.1,
          0.8
        ]
      }
    },
    {
      "name": "rejects_zero_quantity",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": 500
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.1,
        "depthM": 0.8,
