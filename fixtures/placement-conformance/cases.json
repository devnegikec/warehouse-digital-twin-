        "orientation": [
          1.2,
          1.1,
          0.8
        ]
      }
    },
    {
      "name": "weight_boundary_is_inclusive",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": 500
      },
      "item": {
        "widthM": 1.2,
