{
  "description": "Placement (fit / capacity) conformance cases. Run by BOTH packages/layout-core (vitest) and server (pytest). Expected blocks are generated by `npm run gen:hashes`.",
  "cases": [
    {
      "name": "fits_plain_pallet",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": 500
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.1,
        "depthM": 0.8,
        "weightKg": 100,
        "rotatable": true
      },
      "qty": 1,
      "expected": {
        "fits": true,
        "code": null,
        "orientation": [
          1.2,
          1.1,
          0.8
        ]
      }
    },
    {
      "name": "rotates_to_fit_height_constrained_bin",
      "bin": {
        "widthM": 2.7,
        "heightM": 1,
        "depthM": 1.3,
        "capacityM3": 2.9835,
        "maxWeightKg": null
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.4,
        "depthM": 0.9,
        "weightKg": 50,
        "rotatable": true
      },
      "qty": 1,
      "expected": {
        "fits": true,
        "code": null,
        "orientation": [
          1.4,
          0.9,
          1.2
        ]
      }
    },
    {
      "name": "pinned_orientation_cannot_fit",
      "bin": {
        "widthM": 2.7,
        "heightM": 1,
        "depthM": 1.3,
        "capacityM3": 2.9835,
        "maxWeightKg": null
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.4,
        "depthM": 0.9,
        "weightKg": 50,
        "rotatable": false
      },
      "qty": 1,
      "expected": {
        "fits": false,
        "code": "ITEM_DOES_NOT_FIT_OPENING",
        "orientation": null
      }
    },
    {
      "name": "rejects_item_larger_than_every_orientation",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": 500
      },
      "item": {
        "widthM": 3.5,
        "heightM": 1.1,
        "depthM": 0.8,
        "weightKg": 100,
        "rotatable": true
      },
      "qty": 1,
      "expected": {
        "fits": false,
        "code": "ITEM_DOES_NOT_FIT_OPENING",
        "orientation": null
      }
    },
    {
      "name": "rejects_exceeding_bin_volume",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": 500
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.1,
        "depthM": 0.8,
        "weightKg": 100,
        "rotatable": true
      },
      "qty": 5,
      "expected": {
        "fits": false,
        "code": "EXCEEDS_BIN_VOLUME",
        "orientation": [
          1.2,
          1.1,
          0.8
        ]
      }
    },
    {
      "name": "rejects_exceeding_beam_weight_limit",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": 500
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.1,
        "depthM": 0.8,
        "weightKg": 250,
        "rotatable": true
      },
      "qty": 3,
      "expected": {
        "fits": false,
        "code": "EXCEEDS_BIN_WEIGHT",
        "orientation": [
          1.2,
          1.1,
          0.8
        ]
      }
    },
    {
      "name": "volume_boundary_is_inclusive",
      "bin": {
        "widthM": 2.7,
        "heightM": 1.6,
        "depthM": 1,
        "capacityM3": 3.672,
        "maxWeightKg": null
      },
      "item": {
        "widthM": 1.2,
        "heightM": 1.1,
        "depthM": 0.8,
        "weightKg": 100,
        "rotatable": true
      },
      "qty": 3,
      "expected": {
        "fits": true,
